# Copy to backend/.env.llm. These settings are read by app/agents/llm_client.py.
LLM_LOCAL_BASE_URL=http://localhost:11434
LLM_LOCAL_MODEL=qwen2.5:7b-instruct
LLM_LOCAL_VISION_MODEL=qwen2.5vl:7b
LLM_PROVIDER_DEFAULT=local
LLM_GEMINI_API_KEY=your-key-here
LLM_GEMINI_MODEL=your-gemini-model
LLM_FALLBACK=on
